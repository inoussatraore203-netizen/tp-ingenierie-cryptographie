# racine.cnf - AC racine (hors ligne) : signe l'intermediaire et sa propre CRL
[ ca ]
default_ca = CA_racine

[ CA_racine ]
dir               = ./racine
database          = $dir/index.txt
new_certs_dir     = $dir/newcerts
serial            = $dir/serial
crlnumber         = $dir/crlnumber
certificate       = $dir/racine.crt
private_key       = $dir/racine.key
default_md        = sha384
default_days      = 1825
default_crl_days  = 30
unique_subject    = no
policy            = policy_racine
copy_extensions   = none
crl_extensions    = ext_crl

[ policy_racine ]
countryName       = match
organizationName  = match
commonName        = supplied

# Extensions imposees a l'AC intermediaire
[ ext_inter ]
basicConstraints       = critical,CA:TRUE,pathlen:0
keyUsage               = critical,keyCertSign,cRLSign
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid:always
nameConstraints        = critical,permitted;DNS:tp.local,permitted;email:tp.local

[ ext_crl ]
authorityKeyIdentifier = keyid:always
